# Placeholder-only template. NEVER put real secrets in this file.
# Copy to .env locally. In production use a secret manager.

# Environment & local container ports
APP_ENV=development
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
WEB_HOST_PORT=3000
POSTGRES_USER=metuse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metuse
METUSE_APP_PASSWORD=change-me-app

# Core infrastructure
# Host tools / Alembic migrations (DB owner role):
DATABASE_URL=postgresql://metuse:change-me@localhost:5433/metuse
# Runtime API / app connections (non-superuser NOSUPERUSER NOBYPASSRLS role):
APP_DATABASE_URL=postgresql://metuse_app:change-me-app@localhost:5433/metuse
REDIS_URL=redis://localhost:6379/0
S3_INTERNAL_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=metuse-dev
TEMPORAL_ADDRESS=localhost:7233
SECRET_STORE_BACKEND=env_dev

# App auth
APP_JWT_SECRET=
SESSION_COOKIE_SECURE=true
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Meta Muse (Model API) - separate from Graph API credentials
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_API_KEY=

# Video providers (mock first)
VIDEO_PROVIDER_DEFAULT=mock
RUNWAY_API_KEY=
GEMINI_API_KEY=
KLING_API_KEY=

# Meta Graph / Instagram Platform (separate from Muse)
META_AUTH_MODE=mock_dev
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=

# Supabase (Managed PostgreSQL, Auth, Storage) — free-tier-first cloud infrastructure
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or SUPABASE_JWT_SECRET in browser-side code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Cloudflare (Edge hosting & DNS)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Monitoring (optional Sentry free tier)
SENTRY_DSN=
